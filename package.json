  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm registry:verify && next build",
    "start": "next start",
    "generate": "node scripts/generate.mjs",
    "content:build": "velite build --strict --clean",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
