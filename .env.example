# PostHog browser configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=your_posthog_host

# PostHog source map upload (build-time only; use the "Source map upload" key
# preset so the key has the "error tracking write" scope the build needs)
# Create at: https://eu.posthog.com/settings/user-api-keys
POSTHOG_API_KEY=your_personal_api_key
POSTHOG_PROJECT_ID=your_posthog_project_id

# Optional until you choose a public production URL. No trailing page path.
# SITE_URL=https://my-site.vercel.app

# Stay false while the homepage is unfinished or you haven't chosen a canonical URL.
SEO_INDEXABLE=false
